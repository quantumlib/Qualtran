REGISTER r0 "target"
APPEND_TO_REGISTER q0 r0
APPEND_TO_REGISTER q1 r0
APPEND_TO_REGISTER q2 r0
APPEND_TO_REGISTER q3 r0
APPEND_TO_REGISTER q4 r0
REGISTER r1 "out"
APPEND_TO_REGISTER b0 r1
APPEND_TO_REGISTER b1 r1
APPEND_TO_REGISTER b2 r1
APPEND_TO_REGISTER b3 r1
APPEND_TO_REGISTER b4 r1
SWAP q0 q4
SWAP q1 q3
HMR q0 b0
Z_POW q1 0.5 if b0
HMR q1 b1
Z_POW q2 0.5 if b1
Z_POW q2 0.25 if b0
HMR q2 b2
Z_POW q3 0.5 if b2
Z_POW q3 0.25 if b1
Z_POW q3 0.125 if b0
HMR q3 b3
Z_POW q4 0.5 if b3
Z_POW q4 0.25 if b2
Z_POW q4 0.125 if b1
Z_POW q4 0.0625 if b0
HMR q4 b4
